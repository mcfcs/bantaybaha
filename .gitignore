# Raw data come from the download scripts / team bucket; caches are rebuilt by scripts/build.py.
# data/processed/ (the build outputs) IS committed (team decision 2026-10-24): a snapshot so a clone can run the dashboard,
# report and spec without the ~1.5 h build. Usability-test answers never go into git.
data/raw/*
data/interim/
!data/raw/MANIFEST.csv
data/*.log
data/processed/sus/

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Credentials
.netrc
*.json.key
.env
# Playwright CLI output (may contain credentials)
.playwright-cli/

# LaTeX build artifacts. latexmk and LaTeX Workshop write everything to docs/spec/build/ (aux files and main.pdf);
# the PDF that is shared is copied to docs/results/Bantay-Baha_Technical_Spec.pdf by scripts/make_spec.py.
# The patterns below catch a stray build run without the output directory.
docs/spec/build/
docs/spec/**/*.aux
docs/spec/**/*.bbl
docs/spec/**/*.bcf
docs/spec/**/*.blg
docs/spec/**/*.fdb_latexmk
docs/spec/**/*.fls
docs/spec/**/*.log
docs/spec/**/*.out
docs/spec/**/*.run.xml
docs/spec/**/*.synctex.gz
docs/spec/**/*.synctex(busy)
docs/spec/**/*.toc
docs/spec/**/*.xdv
docs/spec/main.pdf
