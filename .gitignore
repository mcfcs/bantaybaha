# Raw and derived data are rebuilt by scripts/download_data.py
data/raw/*
data/interim/
data/processed/
!data/raw/MANIFEST.csv
data/*.log

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Credentials
.netrc
*.json.key
.env
# Playwright CLI output (may contain credentials)
.playwright-cli/

# LaTeX build artifacts (docs/spec/build/ holds the aux files and the PDF; the PDF is copied to docs/results/)
docs/spec/build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.synctex(busy)
*.toc
*.xdv
